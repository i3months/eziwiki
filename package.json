{
  "name": "eziwiki",
  "version": "0.1.0",
  "description": "An easy-to-use wiki and documentation site generator built with Next.js",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build:pdfjs && npm run build:pdf-images && next dev",
    "build": "npm run validate:payload && npm run check:links && npm run build:pdfjs && npm run build:pdf-images && next build",
    "export": "npm run build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "validate:payload": "tsx scripts/validate-payload.ts",
    "show-urls": "tsx scripts/show-urls.ts",
    "new": "tsx scripts/new-page.ts",
    "build:pdfjs": "tsx scripts/copy-pdfjs-assets.ts",
    "build:pdf-images": "tsx scripts/build-pdf-images.ts",
    "check:links": "tsx scripts/check-links.ts",
    "build:template": "tsx scripts/build-template.ts",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "predev": "node -e \"fs.rmSync('public/search-index.json',{force:true})\"",
    "prebuild": "node -e \"fs.rmSync('public/search-index.json',{force:true})\""
  },
  "dependencies": {
    "@shikijs/rehype": "^4.3.1",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "beautiful-mermaid": "^1.1.3",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.554.0",
    "mdast-util-to-string": "^4.0.0",
    "minisearch": "^7.2.0",
    "next": "^16.3.4",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.6",
    "@tailwindcss/typography": "^0.5.10",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "vitest": "^4.0.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i3months/eziwiki.git"
  },
  "homepage": "https://github.com/i3months/eziwiki#readme",
  "bugs": "https://github.com/i3months/eziwiki/issues"
}
